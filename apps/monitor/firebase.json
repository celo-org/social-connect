{
  "functions": {
    "source": "deploy",
    "predeploy": [
      "yarn --cwd \"$RESOURCE_DIR/..\" run lint",
      "yarn --cwd \"$RESOURCE_DIR/..\" run build",
      "yarn --cwd \"$RESOURCE_DIR/..\" run bundle",
      "npm --prefix \"$RESOURCE_DIR\" ci --ignore-scripts --no-audit --no-fund"
    ]
  }
}

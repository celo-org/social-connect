# Stage 1: Build the binary
# The Rust version must match rust-toolchain.toml.
FROM rust:1.100.0-trixie@sha256:e19840879045c951c905d0eaa9887f3439c62000e429963371b376bac8d38c31 AS build

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY rust/ rust/

RUN cargo build --release -p odis-signer

# Stage 2: Runtime
# Same Debian release as the build stage, so the binary finds the glibc it was linked against.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/target/release/odis-signer /bin/odis-signer

USER nobody
WORKDIR /app

# SERVER_PORT defaults to 8080.
EXPOSE 8080

ENTRYPOINT ["/bin/odis-signer"]
